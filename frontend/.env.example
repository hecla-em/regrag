VITE_API_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:5173
# Prod builds only: errors go to Sentry when set. SENTRY_AUTH_TOKEN, a build variable and
# not a VITE_ one, uploads the source maps.
# VITE_SENTRY_DSN=
# The public half of the Cloudflare Turnstile widget. Unset, no token is minted and the
# question goes without one, which the backend's own check being off then allows.
# VITE_TURNSTILE_SITE_KEY=
