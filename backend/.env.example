# Copied to .env.dev (cp .env.example .env.dev) and also read directly as the test env file,
# so tests override DB_NAME in tests/__init__.py rather than here.

# ---- Required ---------------------------------------------------------------------------

# PostgreSQL (the compose db service)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=regrag

# One per provider a model may name (ProviderConfig); a model is called with the key of the
# provider it names, so a model swap is a setting. Real keys go in .env.dev; empty here so
# tests never reach a provider.
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- App (AppConfig) --------------------------------------------------------------------

# PROJECT_NAME=RegRag
# The one origin CORS allows; the Vite dev origin by default
# FRONTEND_URL=http://localhost:5173
# Set by Fly on every machine; names the release. GITHUB_SHA stands in on a GitHub Actions
# job, and it is "local" when both are unset
# FLY_IMAGE_REF=
# Prod only: ERROR log lines and the nightly ingest's check-in go to Sentry when set
# SENTRY_DSN=

# ---- Redis (RedisConfig) ----------------------------------------------------------------

# The compose redis service; on Fly the Upstash instance's private URL
# REDIS_URL=redis://localhost:6379/0
# REDIS_TIMEOUT=1.0

# ---- Rate limit (RateLimitConfig) -------------------------------------------------------

# Questions one client id, and one address across ids, may ask per sliding window on /chat
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_CLIENT=5
# RATE_LIMIT_PER_IP=20
# RATE_LIMIT_WINDOW_SECONDS=60

# ---- Turnstile (TurnstileConfig) --------------------------------------------------------

# Cloudflare's browser check on /chat, which a script rotating addresses cannot pass. Off
# here and in dev, so nothing has to mint a token. On in prod, with the secret half of the
# widget whose sitekey the frontend was built with. Left empty, the check lets questions
# through rather than refuse every one of them
# TURNSTILE_ENABLED=false
# TURNSTILE_SECRET_KEY=
# TURNSTILE_TIMEOUT=5.0

# ---- Postgres pool (PostgresConfig) -----------------------------------------------------

# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=3
# DB_POOL_PRE_PING=true
# DB_POOL_RECYCLE=300
# DB_POOL_TIMEOUT=30
# DB_CONNECT_TIMEOUT=10
# DB_COMMAND_TIMEOUT=30
# verify-full by default in prod; set it wherever DB_HOST is the prod database
# DB_SSLMODE=verify-full

# ---- Storage (StorageConfig, R2Config) --------------------------------------------------

# local (filesystem, dev and tests) or r2 (Cloudflare R2, prod)
# STORAGE_BACKEND=local
# Root of the local store; defaults to <repo>/data/raw
# RAW_DATA_DIR=/var/lib/regrag/raw

# All four required when STORAGE_BACKEND=r2; real values go in .env.prod
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# ---- Embedding (EmbeddingConfig) --------------------------------------------------------

# EMBED_MODEL=voyage/voyage-4-lite
# EMBED_TIMEOUT=30

# ---- Chat (ChatConfig) ------------------------------------------------------------------

# The one model every node of the graph calls; any provider litellm names
# CHAT_MODEL=anthropic/claude-haiku-4-5
# CHAT_TIMEOUT=60
# CHAT_MAX_TOKENS=2048
# CHAT_TEMPERATURE=0.0
# CHAT_SOURCES=5
# CHAT_CONTEXT_CHUNKS=15
# CHAT_THREAD_TURNS=5
# CHAT_DAILY_SPEND_CAP_USD=5.0
# A repeated first question is answered from Redis until a deploy, a setting or the corpus changes
# CHAT_CACHE_ENABLED=true
# CHAT_CACHE_TTL_SECONDS=604800
# The answer call reasons before it writes, within this many tokens
# CHAT_THINKING_ENABLED=false
# CHAT_THINKING_BUDGET=1024

# ---- Assess loop (AssessConfig) ---------------------------------------------------------

# ASSESS_ENABLED=true
# ASSESS_MAX_ROUNDS=1
# ASSESS_MAX_CALLS=4
# ASSESS_SEARCH_LIMIT=5
# ASSESS_FOLLOW_LIMIT=5
# ASSESS_EXTRA_CHUNKS=10
# ASSESS_MAY_REFUSE=true

# ---- Decompose (DecomposeConfig) --------------------------------------------------------

# DECOMPOSE_ENABLED=false
# DECOMPOSE_MAX_PARTS=3

# ---- Ingest (IngestConfig) --------------------------------------------------------------

# JSON objects
# TOPIC_BASE_ACTS={"fueleu": "32023R1805", "mrv": "32015R0757"}
# CRAWL_DELAYS={"eur-lex.europa.eu": 10.0, "publications.europa.eu": 1.0}
# MAX_DROP_RATIO=0.2
# MIN_SUSPICIOUS_DROPS=3
# MAX_CHARS=2000
# EMBED_PAGE_SIZE=500
# EMBED_CONCURRENCY=4
# MAX_FAILURE_CHARS=500

# ---- Retrieval (RetrievalConfig) --------------------------------------------------------

# SEARCH_CANDIDATES=50
# SEARCH_DEFAULT_LIMIT=10
# EF_SEARCH_PER_CANDIDATE=4
# RRF_K=60
# RERANK_ENABLED=true
# RERANK_MODEL=voyage/rerank-2.5
# RERANK_TIMEOUT=30
# RERANK_POOL=30
# EXPAND_SECTIONS=false
# MIN_COSINE_SIMILARITY=0.30
# MIN_RERANKER_RELEVANCE=0.45

# ---- Evals (EvalConfig, JudgeConfig) ----------------------------------------------------

# EVAL_DATASET_PATH=app/evals/dataset/golden.json
# Defaults to <repo>/data/cache/evals
# EVAL_CACHE_DIR=/var/cache/regrag/evals
# EVAL_JUDGE_MODEL=anthropic/claude-sonnet-5
# EVAL_JUDGE_TIMEOUT=120
# EVAL_JUDGE_MAX_TOKENS=8192
# EVAL_JUDGE_CONCURRENCY=4
